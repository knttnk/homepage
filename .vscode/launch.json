{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "非本番環境デバッグ",
            "type": "node",
            "request": "launch",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "${workspaceFolder}/.pixi/envs/default/npm.cmd",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
        },
        {
            "name": "Chromeで起動",
            "type": "chrome",
            "preLaunchTask": "サーブ開始",
            "request": "launch",
            "url": "http://localhost:3000/",
            "webRoot": "${workspaceFolder}",
            "skipFiles": [
                "chrome-extension://**"
            ],
            "runtimeArgs": [
                "--auto-open-devtools-for-tabs",
            ]
        }
    ]
}